# --- genres.html: справочник FB2-таксономии, интерактивные ассоциации (баг №113) ---
msgid "Reset all exact associations"
msgstr "Сбросить все точные ассоциации"

msgid "FB2 Genre Reference"
msgstr "Справочник FB2-жанров"

msgid "Official FB2 genre-code taxonomy (opds_catalog/fixtures/mygenres.json)."
msgstr "Официальная таксономия FB2-кодов (opds_catalog/fixtures/mygenres.json)."

msgid "Click the card title to switch between mapping whole sections and mapping individual codes."
msgstr "Кликните на заголовок карточки, чтобы переключиться между сопоставлением целых разделов и отдельных кодов."

msgid "Click to switch between by-section and by-code view"
msgstr "Клик для переключения между видом по разделам и по кодам"

msgid "by section"
msgstr "по разделам"

msgid "by code"
msgstr "по кодам"

msgid "Map each section to one of your genres so raw codes resolve objectively, instead of relying only on manually taught associations. Hover over the code count to see the actual codes."
msgstr "Сопоставьте каждый раздел одному из ваших жанров, чтобы сырые коды разрешались объективно, а не только через вручную накопленные ассоциации. Наведите на число кодов, чтобы увидеть сами коды."

msgid "Assign a genre directly to an individual code — useful for mixed sections (e.g. \"Unknown genre\") where different codes really belong to different genres."
msgstr "Назначьте жанр напрямую отдельному коду — полезно для смешанных разделов (напр. «Unknown genre»), где разные коды на самом деле относятся к разным жанрам."

msgid "Click to sort"
msgstr "Клик для сортировки"

msgid "Code"
msgstr "Код"

msgid "Section"
msgstr "Раздел"

msgid "Codes"
msgstr "Кодов"

msgid "— not mapped —"
msgstr "— не назначено —"

msgid "Excluded Codes (never a genre signal)"
msgstr "Исключённые коды (никогда не жанр)"

msgid "Codes describing publication format, not genre (e.g. \"compilation\", \"collection\") — never learned as an exact association, no matter what genre is applied to a combination containing them."
msgstr "Коды, описывающие формат публикации, а не жанр (напр. «compilation», «collection») — никогда не запоминаются как точная ассоциация, какой бы жанр ни применили к содержащей их комбинации."

msgid "e.g. compilation"
msgstr "напр. compilation"

msgid "No excluded codes"
msgstr "Нет исключённых кодов"

msgid "Exact associations"
msgstr "Точные ассоциации"

msgid "code"
msgstr "код"

msgid "Code-family patterns"
msgstr "Правила по семейству кода"

msgid "family, e.g. sf"
msgstr "семейство, напр. sf"

msgid "Reset ALL exact associations for ALL genres? This cannot be undone (section mapping and code-family patterns are kept)."
msgstr "Сбросить ВСЕ точные ассоциации у ВСЕХ жанров? Отменить нельзя (сопоставление разделов и правила по семейству кода сохранятся)."
